# Copy this file to `.streamlit/secrets.toml` locally (DO NOT commit the secrets file).
# Example Streamlit secrets for local development and Streamlit Cloud.

[secrets]
# Replace the placeholder with your real Cohere API key in your local secrets file.
# Never commit the real `.streamlit/secrets.toml` to source control.
COHERE_API_KEY = "your-cohere-api-key-here"

# For Streamlit Cloud: go to App Settings → Secrets and paste the contents of the
# file (without committing to the repo).
